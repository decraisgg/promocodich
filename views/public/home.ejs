<%- include('partials/header') %>

<!-- HERO: большой баннер по центру + два маленьких по бокам -->
<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-side">
        <% if (smallBanners[0]) { %>
          <%- include('partials/banner', { b: smallBanners[0], variant: 'small' }) %>
        <% } %>
      </div>

      <div class="hero-main">
        <% if (bigBanner) { %>
          <%- include('partials/banner', { b: bigBanner, variant: 'big' }) %>
        <% } else { %>
          <div class="banner banner--big banner--noimg">
            <div class="banner-content">
              <span class="hero-badge">ТОЛЬКО НА ПРОМОКОДЫЧ</span>
              <h1 class="banner-title"><%= site.tagline || 'Лучшие промокоды' %></h1>
              <p class="banner-subtitle"><%= site.intro_text || '' %></p>
              <a class="banner-btn" href="#promocodes">Смотреть промокоды</a>
            </div>
          </div>
        <% } %>
      </div>

      <div class="hero-side">
        <% if (smallBanners[1]) { %>
          <%- include('partials/banner', { b: smallBanners[1], variant: 'small' }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%
  // Render content sections in the admin-configured order.
  (homeSections || ['promocodes','sites','articles']).forEach(function(sec){
%>

  <% if (sec === 'promocodes') { %>
    <!-- ПРОМОКОДЫ (БОНУСЫ) -->
    <section class="section" id="promocodes">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title"><% if (sections.promocodes.icon) { %><img class="ico-img" src="<%= sections.promocodes.icon %>" alt=""><% } else { %><span class="ico">%</span><% } %> <%= sections.promocodes.title %></h2>
          <% if (sections.promocodes.sub) { %><p class="section-sub"><%= sections.promocodes.sub %></p><% } %>
        </div>

        <%
          var __perPage = parseInt(promoPerPage, 10) || 0;
          var __inlineBanners = inlineBanners || [];
          // Build rows: 3 cards per row
          var __cards = promocodes || [];
          var __totalCards = __cards.length;
          var __paginationEnabled = __perPage > 0 && __totalCards > __perPage;
        %>

        <div class="promo-section-wrap" data-per-page="<%= __perPage %>" data-total="<%= __totalCards %>">
          <div class="promo-grid" id="promoGrid">
            <% if (!__totalCards) { %>
              <p class="empty-note">Промокоды скоро появятся.</p>
            <% } %>
            <% __cards.forEach(function(p, idx){ %>
              <%
                // After which card-row should we insert inline banners?
                // row number = Math.floor(idx / 3) + 1 (1-based, after rendering 3 cards)
                var __rowNum = Math.floor(idx / 3) + 1;
                var __isRowEnd = (idx + 1) % 3 === 0;
              %>
              <article class="promo-card" data-promo-idx="<%= idx %>">
                <div class="promo-top">
                  <div class="promo-logo">
                    <% if (p.image_url) { %>
                      <img src="<%= p.image_url %>" alt="<%= p.service_name %>">
                    <% } else { %>
                      <span class="promo-logo-fallback"><%= (p.service_name || '?').slice(0,2).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <div class="promo-titles">
                    <h3 class="promo-service"><%= p.service_name %></h3>
                    <% if (p.bonus_label) { %><span class="promo-bonus"><%= p.bonus_label %></span><% } %>
                  </div>
                </div>
                <% if (p.description) { %><p class="promo-desc"><%= p.description %></p><% } %>
                <% if (p.code) { %>
                  <div class="promo-code" data-code="<%= p.code %>">
                    <span class="promo-code-value"><%= p.code %></span>
                    <button class="promo-code-copy" type="button">Копировать</button>
                  </div>
                <% } %>
                <a class="promo-go" href="<%= p.link || '#' %>" target="_blank" rel="nofollow noopener" data-track="Промокод: <%= p.service_name || ('#'+p.id) %>">Получить бонус</a>
              </article>
              <%
                // Insert inline banners after this row
                if (__isRowEnd || idx === __totalCards - 1) {
                  var __completedRow = Math.floor(idx / 3) + 1;
                  __inlineBanners.forEach(function(ib) {
                    if (parseInt(ib.after_row, 10) === __completedRow) {
              %>
                      <div class="inline-banner<%= ib.banner_image ? ' inline-banner--bg' : '' %>" data-ib-id="<%= ib.id %>"<% if (ib.banner_image) { %> style="background-image:url('<%= ib.banner_image %>')"<% } %>>
                        <div class="inline-banner-content">
                          <% if (ib.image_enabled && ib.image_url) { %>
                            <img class="inline-banner-img" src="<%= ib.image_url %>" alt="">
                          <% } %>
                          <% if (ib.text_enabled && ib.text) { %>
                            <span class="inline-banner-text"><%= ib.text %></span>
                          <% } %>
                          <% if (ib.code_enabled && ib.code) { %>
                            <div class="promo-code inline-banner-code" data-code="<%= ib.code %>">
                              <span class="promo-code-value"><%= ib.code %></span>
                              <button class="promo-code-copy" type="button">Копировать</button>
                            </div>
                          <% } %>
                          <% if (ib.button_enabled && ib.button_text) { %>
                            <a class="inline-banner-btn" href="<%= ib.button_link || '#' %>" target="_blank" rel="nofollow noopener" data-track="Межстрочная плашка #<%= ib.id %>"><%= ib.button_text %></a>
                          <% } %>
                        </div>
                      </div>
              <%
                    }
                  });
                }
              %>
            <% }); %>
          </div>

          <% if (__paginationEnabled) { %>
          <div class="promo-pagination" id="promoPagination">
            <% var __pages = Math.ceil(__totalCards / __perPage); %>
            <% for (var __pi = 1; __pi <= __pages; __pi++) { %>
              <button class="promo-page-btn <%= __pi === 1 ? 'active' : '' %>" data-page="<%= __pi %>"><%= __pi %></button>
            <% } %>
          </div>
          <% } %>
        </div>

      </div>
    </section>
  <% } %>

  <% if (sec === 'sites' && homeServices && homeServices.length) { %>
    <!-- ПОПУЛЯРНЫЕ САЙТЫ -->
    <section class="section section--sites">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title"><% if (sections.sites.icon) { %><img class="ico-img" src="<%= sections.sites.icon %>" alt=""><% } else { %><span class="ico">%</span><% } %> <%= sections.sites.title %></h2>
          <a class="section-link" href="/services">Все сайты →</a>
        </div>
        <div class="sites-tiles">
          <% homeServices.forEach(function(svc){ var tile = svc.tile_image || svc.image_url; %>
            <a class="site-tile" href="/services/<%= svc.slug %>" style="<%= svc.color ? '--svc-color:' + svc.color : '' %>" data-track="Сайт: <%= svc.name %>">
              <div class="site-tile-logo">
                <% if (tile) { %>
                  <img src="<%= tile %>" alt="<%= svc.name %>">
                <% } else { %>
                  <span class="site-tile-logo-text"><%= svc.name %></span>
                <% } %>
              </div>
              <div class="site-tile-name"><%= svc.name %></div>
            </a>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <% if (sec === 'articles' && latestArticles.length) { %>
    <!-- ПОСЛЕДНИЕ СТАТЬИ -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title"><% if (sections.articles.icon) { %><img class="ico-img" src="<%= sections.articles.icon %>" alt=""><% } else { %><span class="ico">%</span><% } %> <%= sections.articles.title %></h2>
          <a class="section-link" href="/articles">Все статьи →</a>
        </div>
        <div class="article-grid">
          <% latestArticles.forEach(function(a){ %>
            <a class="article-card" href="/articles/<%= a.slug %>">
              <div class="article-thumb<%= a.featured_image ? '' : ' is-empty' %>"
                   <% if (a.featured_image) { %>style="background-image:url('<%= a.featured_image %>')"<% } %>>
                <span class="article-cat"><%= a.categoryTitle %></span>
              </div>
              <div class="article-card-body">
                <h3 class="article-card-title"><%= a.title %></h3>
                <% if (a.excerpt) { %><p class="article-card-excerpt"><%= a.excerpt %></p><% } %>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

<% }); %>

<%- include('partials/footer') %>
