<%
  // Resolve SEO with safe fallbacks so views that don't pass `seo` still render.
  var __seo  = (typeof seo !== 'undefined' && seo) ? seo : {};
  var __title = __seo.title || (typeof pageTitle !== 'undefined' ? pageTitle : (site.site_title || 'ПРОМОКОДЫЧ'));
  var __desc  = __seo.description || site.seo_default_description || site.tagline || '';
  var __kw    = __seo.keywords || site.seo_default_keywords || '';
  var __canon = __seo.canonical || '';
  var __ogimg = __seo.ogImageAbs || '';
  var __ogtype = __seo.ogType || 'website';
  var __noindex = !!__seo.noindex;
  var __siteName = __seo.siteName || site.site_title || 'ПРОМОКОДЫЧ';
  var __yav = (__seo.yandexVerification || site.seo_yandex_verification || '');
  var __gv  = (__seo.googleVerification || site.seo_google_verification || '');
%><!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __title %></title>
  <% if (__desc) { %><meta name="description" content="<%= __desc %>"><% } %>
  <% if (__kw) { %><meta name="keywords" content="<%= __kw %>"><% } %>
  <meta name="robots" content="<%= __noindex ? 'noindex, nofollow' : 'index, follow' %>">
  <% if (__canon) { %><link rel="canonical" href="<%= __canon %>"><% } %>
  <% if (__yav) { %><meta name="yandex-verification" content="<%= __yav %>"><% } %>
  <% if (__gv)  { %><meta name="google-site-verification" content="<%= __gv %>"><% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="<%= __ogtype %>">
  <meta property="og:site_name" content="<%= __siteName %>">
  <meta property="og:title" content="<%= __title %>">
  <% if (__desc) { %><meta property="og:description" content="<%= __desc %>"><% } %>
  <% if (__canon) { %><meta property="og:url" content="<%= __canon %>"><% } %>
  <% if (__ogimg) { %><meta property="og:image" content="<%= __ogimg %>"><% } %>

  <!-- Twitter -->
  <meta name="twitter:card" content="<%= __ogimg ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= __title %>">
  <% if (__desc) { %><meta name="twitter:description" content="<%= __desc %>"><% } %>
  <% if (__ogimg) { %><meta name="twitter:image" content="<%= __ogimg %>"><% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
  <% if (site.favicon_url) { %>
    <link rel="icon" href="<%= site.favicon_url %>">
  <% } else { %>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23ff2d55'/><text x='50' y='72' font-size='66' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'>%25</text></svg>">
  <% } %>
</head>
<body>
  <div class="site-header-wrap">
    <header class="site-header" id="siteHeader">
      <div class="header-inner">
        <a class="brand" href="/">
          <% if (site.logo_url) { %>
            <img class="brand-logo-img" src="<%= site.logo_url %>" alt="<%= site.site_title || 'ПРОМОКОДЫЧ' %>">
          <% } else { %>
            <span class="brand-logo">%</span>
          <% } %>
          <span class="brand-name"><%= site.site_title || 'ПРОМОКОДЫЧ' %></span>
        </a>
        <nav class="main-nav" id="mainNav">
          <a href="/" class="<%= page === 'home' ? 'active' : '' %>"><%= site.nav_home || 'Главная' %></a>
          <a href="/#promocodes"><%= site.nav_promocodes || 'Промокоды' %></a>
          <a href="/rating" class="<%= page === 'rating' ? 'active' : '' %>"><%= site.nav_rating || 'Рейтинг' %></a>
          <a href="/services" class="<%= page === 'services' ? 'active' : '' %>"><%= site.nav_services || 'Сайты' %></a>
          <a href="/articles" class="<%= page === 'articles' ? 'active' : '' %>"><%= site.nav_articles || 'Статьи' %></a>
          <a href="/contacts" class="<%= page === 'contacts' ? 'active' : '' %>"><%= site.nav_contacts || 'Контакты' %></a>
        </nav>
        <% if (String(site.gift_enabled) === '1') { %>
          <div class="header-gift" id="giftWidget">
            <button class="gift-fab" id="giftFab" aria-label="Подарок" aria-expanded="false">
              <% if (site.gift_icon_image) { %>
                <img src="<%= site.gift_icon_image %>" alt="Подарок">
              <% } else { %>
                <span class="gift-fab-emoji"><%= site.gift_icon || '🎁' %></span>
              <% } %>
            </button>
            <div class="gift-panel" id="giftPanel" role="dialog" aria-label="Подарок">
              <button class="gift-close" id="giftClose" aria-label="Закрыть">×</button>
              <% if (site.gift_image) { %>
                <div class="gift-panel-image" style="background-image:url('<%= site.gift_image %>')"></div>
              <% } %>
              <div class="gift-panel-body">
                <% if (site.gift_text) { %><p class="gift-panel-text"><%= site.gift_text %></p><% } %>
                <% if (site.gift_code) { %>
                  <div class="gift-panel-code" data-code="<%= site.gift_code %>">
                    <span class="gift-code-value"><%= site.gift_code %></span>
                    <button class="gift-code-copy" type="button">Копировать</button>
                  </div>
                <% } %>
                <% if (site.gift_button_text) { %>
                  <a class="gift-panel-btn" href="<%= site.gift_button_link || '#' %>" target="_blank" rel="nofollow noopener"><%= site.gift_button_text %></a>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
        <button class="nav-toggle" id="navToggle" aria-label="Меню" aria-expanded="false">☰</button>
      </div>
    </header>
  </div>

  <main class="page-main">
