<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : (site.site_title || 'ПРОМОКОДЫЧ') %></title>
  <meta name="description" content="<%= site.tagline || 'Промокоды на цифровые сервисы' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23ff2d55'/><text x='50' y='72' font-size='66' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'>%25</text></svg>">
</head>
<body>
  <header class="site-header" id="siteHeader">
    <div class="container header-inner">
      <a class="brand" href="/">
        <% if (site.logo_url) { %>
          <img class="brand-logo-img" src="<%= site.logo_url %>" alt="<%= site.site_title || 'ПРОМОКОДЫЧ' %>">
        <% } else { %>
          <span class="brand-logo">%</span>
        <% } %>
        <span class="brand-name"><%= site.site_title || 'ПРОМОКОДЫЧ' %></span>
      </a>
      <nav class="main-nav">
        <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Главная</a>
        <a href="/#promocodes">Промокоды</a>
        <% if ((services || []).length) { %>
          <div class="nav-dropdown">
            <a href="/services" class="<%= page === 'services' ? 'active' : '' %>">Сервисы ▾</a>
            <div class="dropdown-menu">
              <% (services || []).forEach(function(svc){ %>
                <a href="/services/<%= svc.slug %>"><%= svc.name %></a>
              <% }); %>
              <a href="/services" class="dropdown-all">Все сервисы →</a>
            </div>
          </div>
        <% } %>
        <div class="nav-dropdown">
          <a href="/articles" class="<%= page === 'articles' ? 'active' : '' %>">Статьи ▾</a>
          <div class="dropdown-menu">
            <% (categories || []).forEach(function(c){ %>
              <a href="/articles?category=<%= c.slug %>"><%= c.title %></a>
            <% }); %>
          </div>
        </div>
        <a href="/giveaways" class="<%= page === 'giveaways' ? 'active' : '' %> nav-giveaways">🎁 Розыгрыши</a>
        <a href="/contacts" class="<%= page === 'contacts' ? 'active' : '' %>">Контакты</a>
      </nav>
      <button class="nav-toggle" id="navToggle" aria-label="Меню">☰</button>
    </div>
  </header>

  <!-- Wavy decoration below header -->
  <div class="header-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 36" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,18 C180,36 360,0 540,18 C720,36 900,0 1080,18 C1260,36 1380,10 1440,18 L1440,36 L0,36 Z" fill="rgba(255,45,85,0.07)"/>
      <path d="M0,26 C240,12 480,36 720,22 C960,8 1200,32 1440,20 L1440,36 L0,36 Z" fill="rgba(255,45,85,0.04)"/>
    </svg>
  </div>

  <main class="page-main">
