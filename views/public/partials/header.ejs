<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : (site.site_title || 'ПРОМОКОДЫЧ') %></title>
  <meta name="description" content="<%= site.tagline || 'Промокоды на цифровые сервисы' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23ff2d55'/><text x='50' y='72' font-size='66' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'>%25</text></svg>">
</head>
<body>
  <header class="site-header" id="siteHeader">
    <div class="container header-inner">
      <a class="brand" href="/">
        <span class="brand-logo">%</span>
        <span class="brand-name"><%= site.site_title || 'ПРОМОКОДЫЧ' %></span>
      </a>
      <nav class="main-nav">
        <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Главная</a>
        <a href="/#promocodes">Промокоды</a>
        <div class="nav-dropdown">
          <a href="/articles" class="<%= page === 'articles' ? 'active' : '' %>">Статьи ▾</a>
          <div class="dropdown-menu">
            <% (categories || []).forEach(function(c){ %>
              <a href="/articles?category=<%= c.slug %>"><%= c.title %></a>
            <% }); %>
          </div>
        </div>
        <a href="/contacts" class="<%= page === 'contacts' ? 'active' : '' %>">Контакты</a>
      </nav>
      <button class="nav-toggle" id="navToggle" aria-label="Меню">☰</button>
    </div>
  </header>
  <main class="page-main">
