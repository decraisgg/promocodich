<%
  // Resolve SEO with safe fallbacks so views that don't pass `seo` still render.
  var __seo  = (typeof seo !== 'undefined' && seo) ? seo : {};
  var __title = __seo.title || (typeof pageTitle !== 'undefined' ? pageTitle : (site.site_title || 'ПРОМОКОДЫЧ'));
  var __desc  = __seo.description || site.seo_default_description || site.tagline || '';
  var __kw    = __seo.keywords || site.seo_default_keywords || '';
  var __canon = __seo.canonical || '';
  var __ogimg = __seo.ogImageAbs || '';
  var __ogtype = __seo.ogType || 'website';
  var __noindex = !!__seo.noindex;
  var __siteName = __seo.siteName || site.site_title || 'ПРОМОКОДЫЧ';
  var __yav = (__seo.yandexVerification || site.seo_yandex_verification || '');
  var __gv  = (__seo.googleVerification || site.seo_google_verification || '');
%><!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __title %></title>
  <% if (__desc) { %><meta name="description" content="<%= __desc %>"><% } %>
  <% if (__kw) { %><meta name="keywords" content="<%= __kw %>"><% } %>
  <meta name="robots" content="<%= __noindex ? 'noindex, nofollow' : 'index, follow' %>">
  <% if (__canon) { %><link rel="canonical" href="<%= __canon %>"><% } %>
  <% if (__yav) { %><meta name="yandex-verification" content="<%= __yav %>"><% } %>
  <% if (__gv)  { %><meta name="google-site-verification" content="<%= __gv %>"><% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="<%= __ogtype %>">
  <meta property="og:site_name" content="<%= __siteName %>">
  <meta property="og:title" content="<%= __title %>">
  <% if (__desc) { %><meta property="og:description" content="<%= __desc %>"><% } %>
  <% if (__canon) { %><meta property="og:url" content="<%= __canon %>"><% } %>
  <% if (__ogimg) { %><meta property="og:image" content="<%= __ogimg %>"><% } %>

  <!-- Twitter -->
  <meta name="twitter:card" content="<%= __ogimg ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= __title %>">
  <% if (__desc) { %><meta name="twitter:description" content="<%= __desc %>"><% } %>
  <% if (__ogimg) { %><meta name="twitter:image" content="<%= __ogimg %>"><% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
  <% if (site.favicon_url) { %>
    <link rel="icon" href="<%= site.favicon_url %>">
  <% } else { %>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23ff2d55'/><text x='50' y='72' font-size='66' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'>%25</text></svg>">
  <% } %>

  <%# Yandex.Metrika: full pasted code takes priority, else build from ID %>
  <% if (site.metrika_yandex_code) { %>
    <%- site.metrika_yandex_code %>
  <% } else if (site.metrika_yandex_id) { %>
  <!-- Yandex.Metrika -->
  <script type="text/javascript">
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");
    ym(<%= site.metrika_yandex_id %>, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true });
  </script>
  <noscript><div><img src="https://mc.yandex.ru/watch/<%= site.metrika_yandex_id %>" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
  <% } %>

  <%# Google Analytics: full pasted code takes priority, else build from ID %>
  <% if (site.metrika_google_code) { %>
    <%- site.metrika_google_code %>
  <% } else if (site.metrika_google_id) { %>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.metrika_google_id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= site.metrika_google_id %>');
  </script>
  <% } %>
</head>
<%
  // Background CSS variables (configurable in admin Settings)
  var __bgStyle = '';
  if (site.bg_image) __bgStyle += "--site-bg:url('" + site.bg_image + "');";
  if (site.bg_blur !== undefined && site.bg_blur !== '') __bgStyle += '--site-bg-blur:' + (parseFloat(site.bg_blur) || 0) + 'px;';

  // Header navigation items in the admin-configured order.
  var __navItems = {
    home:       { href: '/',            label: site.nav_home       || 'Главная',   active: page === 'home' },
    promocodes: { href: '/#promocodes', label: site.nav_promocodes || 'Промокоды', active: false },
    rating:     { href: '/rating',      label: site.nav_rating     || 'Рейтинг',   active: page === 'rating' },
    services:   { href: '/services',    label: site.nav_services   || 'Сайты',     active: page === 'services' },
    articles:   { href: '/articles',    label: site.nav_articles   || 'Статьи',    active: page === 'articles' },
    contacts:   { href: '/contacts',    label: site.nav_contacts   || 'Контакты',  active: page === 'contacts' }
  };
  var __navOrder = String(site.nav_order || 'home,promocodes,rating,services,articles,contacts')
    .split(',').map(function (k) { return k.trim(); }).filter(function (k) { return __navItems[k]; });
  Object.keys(__navItems).forEach(function (k) { if (__navOrder.indexOf(k) < 0) __navOrder.push(k); });
%>
<body<% if (__bgStyle) { %> style="<%= __bgStyle %>"<% } %>>
  <div class="site-header-wrap">
    <header class="site-header" id="siteHeader">
      <div class="header-inner">
        <a class="brand" href="/">
          <% if (site.logo_url) { %>
            <img class="brand-logo-img" src="<%= site.logo_url %>" alt="<%= site.site_title || 'ПРОМОКОДЫЧ' %>">
          <% } else { %>
            <span class="brand-logo">%</span>
          <% } %>
          <span class="brand-name"><%= site.site_title || 'ПРОМОКОДЫЧ' %></span>
        </a>
        <nav class="main-nav" id="mainNav">
          <% __navOrder.forEach(function (k) { var it = __navItems[k]; %>
            <% if (k === 'rating') { %>
              <a href="<%= it.href %>" class="<%= it.active ? 'active' : '' %> nav-rating" data-track="Меню: <%= it.label %>">
                <span class="nav-rating-inner"><%= it.label %><% if (String(site.nav_rating_icon_enabled) === '1') { %><% if (site.nav_rating_icon_image) { %><img class="nav-rating-star-img" src="<%= site.nav_rating_icon_image %>" alt=""><% } else { %><span class="nav-rating-star"><%= site.nav_rating_icon || '★' %></span><% } %><% } %></span>
              </a>
            <% } else { %>
              <a href="<%= it.href %>" class="<%= it.active ? 'active' : '' %>" data-track="Меню: <%= it.label %>"><%= it.label %></a>
            <% } %>
          <% }); %>
        </nav>
        <% if (String(site.gift_enabled) === '1') { %>
          <div class="header-gift" id="giftWidget">
            <button class="gift-fab" id="giftFab" aria-label="Подарок" aria-expanded="false" data-track="Подарок (иконка)">
              <% if (site.gift_icon_image) { %>
                <img src="<%= site.gift_icon_image %>" alt="Подарок">
              <% } else { %>
                <span class="gift-fab-emoji"><%= site.gift_icon || '🎁' %></span>
              <% } %>
            </button>
            <div class="gift-panel" id="giftPanel" role="dialog" aria-label="Подарок">
              <button class="gift-close" id="giftClose" aria-label="Закрыть">×</button>
              <% if (site.gift_image) { %>
                <div class="gift-panel-image" style="background-image:url('<%= site.gift_image %>')"></div>
              <% } %>
              <div class="gift-panel-body">
                <% if (site.gift_text) { %><p class="gift-panel-text"><%= site.gift_text %></p><% } %>
                <% if (site.gift_code) { %>
                  <div class="gift-panel-code" data-code="<%= site.gift_code %>">
                    <span class="gift-code-value"><%= site.gift_code %></span>
                    <button class="gift-code-copy" type="button">Копировать</button>
                  </div>
                <% } %>
                <% if (site.gift_button_text) { %>
                  <a class="gift-panel-btn" href="<%= site.gift_button_link || '#' %>" target="_blank" rel="nofollow noopener" data-track="Подарок (кнопка)"><%= site.gift_button_text %></a>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
        <button class="nav-toggle" id="navToggle" aria-label="Меню" aria-expanded="false">☰</button>
      </div>
    </header>
  </div>

  <main class="page-main">
