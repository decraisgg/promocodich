  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <% if (site.logo_url) { %>
          <img class="footer-logo-img" src="<%= site.logo_url %>" alt="<%= site.site_title || 'ПРОМОКОДЫЧ' %>">
        <% } else { %>
          <span class="brand-logo">%</span>
        <% } %>
        <span class="brand-name"><%= site.site_title || 'ПРОМОКОДЫЧ' %></span>
      </div>
      <p class="footer-note">
        Промокоды и бонусы для цифровых сервисов. Все коды проверяются вручную.
      </p>
      <div class="footer-links">
        <a href="/">Главная</a>
        <a href="/#promocodes">Промокоды</a>
        <a href="/rating">Рейтинг</a>
        <a href="/services">Сайты</a>
        <a href="/articles">Статьи</a>
        <a href="/contacts">Контакты</a>
      </div>
      <p class="footer-copy">© <%= currentYear %> <%= site.site_title || 'ПРОМОКОДЫЧ' %>. Все права защищены.</p>
    </div>
  </footer>

  <!-- Всплывающие окна (300×200, левый нижний угол) -->
  <div class="popup-stack" id="popupStack">
    <% (popups || []).forEach(function(p, i){ %>
      <div class="popup-card" data-popup-id="<%= i %>">
        <button class="popup-close" aria-label="Закрыть">×</button>
        <% if (p.image_url) { %>
          <div class="popup-image" style="background-image:url('<%= p.image_url %>')"></div>
        <% } %>
        <div class="popup-body">
          <% if (p.text) { %><p class="popup-text"><%= p.text %></p><% } %>
          <% if (p.code) { %><div class="popup-code"><%= p.code %></div><% } %>
          <% if (p.button_text) { %>
            <a class="popup-btn" href="<%= p.button_link || '#' %>" target="_blank" rel="nofollow noopener"><%= p.button_text %></a>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- Подарок: плавающая иконка + выдвижное окно -->
  <% if (String(site.gift_enabled) === '1') { %>
    <div class="gift-widget" id="giftWidget">
      <button class="gift-fab" id="giftFab" aria-label="Подарок" aria-expanded="false">
        <% if (site.gift_icon_image) { %>
          <img src="<%= site.gift_icon_image %>" alt="Подарок">
        <% } else { %>
          <span class="gift-fab-emoji"><%= site.gift_icon || '🎁' %></span>
        <% } %>
      </button>
      <div class="gift-panel" id="giftPanel" role="dialog" aria-label="Подарок">
        <button class="gift-close" id="giftClose" aria-label="Закрыть">×</button>
        <% if (site.gift_image) { %>
          <div class="gift-panel-image" style="background-image:url('<%= site.gift_image %>')"></div>
        <% } %>
        <div class="gift-panel-body">
          <% if (site.gift_text) { %><p class="gift-panel-text"><%= site.gift_text %></p><% } %>
          <% if (site.gift_code) { %>
            <div class="gift-panel-code" data-code="<%= site.gift_code %>">
              <span class="gift-code-value"><%= site.gift_code %></span>
              <button class="gift-code-copy" type="button">Копировать</button>
            </div>
          <% } %>
          <% if (site.gift_button_text) { %>
            <a class="gift-panel-btn" href="<%= site.gift_button_link || '#' %>" target="_blank" rel="nofollow noopener"><%= site.gift_button_text %></a>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <script src="/static/js/site.js"></script>
</body>
</html>
