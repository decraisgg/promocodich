<%- include('partials/header') %>

<!-- SERVICE HERO -->
<section class="service-hero-section">
  <div class="container">
    <div class="crumbs">
      <a href="/">Главная</a> / <a href="/services">Сайты</a> / <span><%= service.name %></span>
    </div>
    <div class="service-hero-banner<%= service.hero_image ? ' has-img' : '' %>"
         style="<%= service.color ? '--svc-color:' + service.color + ';' : '' %><%= service.hero_image ? "background-image:url('" + service.hero_image + "')" : '' %>">
      <div class="service-hero-inner">
        <div class="service-hero-icon">
          <% if (service.image_url) { %>
            <img src="<%= service.image_url %>" alt="<%= service.name %>">
          <% } else { %>
            <span><%= service.name.slice(0,2).toUpperCase() %></span>
          <% } %>
        </div>
        <div>
          <h1 class="service-hero-title"><%= service.name %></h1>
          <% if (service.description) { %>
            <p class="service-hero-desc"><%= service.description %></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICE BANNERS -->
<% if (bigBanner || smallBanners.length) { %>
<section class="hero hero--service">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-side">
        <% if (smallBanners[0]) { %>
          <%- include('partials/banner', { b: smallBanners[0], variant: 'small' }) %>
        <% } %>
      </div>
      <div class="hero-main">
        <% if (bigBanner) { %>
          <%- include('partials/banner', { b: bigBanner, variant: 'big' }) %>
        <% } %>
      </div>
      <div class="hero-side">
        <% if (smallBanners[1]) { %>
          <%- include('partials/banner', { b: smallBanners[1], variant: 'small' }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- SERVICE PROMO CODES -->
<section class="section" id="promocodes">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><span class="ico">%</span> Промокоды <%= service.name %></h2>
    </div>
    <div class="promo-grid">
      <% if (!promocodes.length) { %>
        <p class="empty-note">Промокоды для этого сервиса скоро появятся.</p>
      <% } %>
      <% promocodes.forEach(function(p){ %>
        <article class="promo-card">
          <div class="promo-top">
            <div class="promo-logo">
              <% if (p.image_url) { %>
                <img src="<%= p.image_url %>" alt="<%= p.service_name %>">
              <% } else { %>
                <span class="promo-logo-fallback"><%= (p.service_name || '?').slice(0,2).toUpperCase() %></span>
              <% } %>
            </div>
            <div class="promo-titles">
              <h3 class="promo-service"><%= p.service_name %></h3>
              <% if (p.bonus_label) { %><span class="promo-bonus"><%= p.bonus_label %></span><% } %>
            </div>
          </div>
          <% if (p.description) { %><p class="promo-desc"><%= p.description %></p><% } %>
          <% if (p.code) { %>
            <div class="promo-code" data-code="<%= p.code %>">
              <span class="promo-code-value"><%= p.code %></span>
              <button class="promo-code-copy" type="button">Копировать</button>
            </div>
          <% } %>
          <a class="promo-go" href="<%= p.link || '#' %>" target="_blank" rel="nofollow noopener">Получить бонус</a>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- OTHER SERVICES -->
<% if (services.filter(function(s){ return s.id !== service.id; }).length) { %>
<section class="section section--tight">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><span class="ico">★</span> Другие сайты</h2>
    </div>
    <div class="sites-tiles">
      <% services.filter(function(s){ return s.id !== service.id; }).forEach(function(svc){ var tile = svc.tile_image || svc.image_url; %>
        <a class="site-tile" href="/services/<%= svc.slug %>" style="<%= svc.color ? '--svc-color:' + svc.color : '' %>">
          <div class="site-tile-logo">
            <% if (tile) { %>
              <img src="<%= tile %>" alt="<%= svc.name %>">
            <% } else { %>
              <span class="site-tile-logo-text"><%= svc.name %></span>
            <% } %>
          </div>
          <div class="site-tile-name"><%= svc.name %></div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
