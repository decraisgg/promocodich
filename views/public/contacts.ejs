<%- include('partials/header') %>

<section class="section">
  <div class="container container--narrow">
    <div class="section-head">
      <h1 class="section-title"><span class="ico">%</span> <%= typeof pageH1 !== 'undefined' ? pageH1 : 'Контакты' %></h1>
    </div>
    <div class="contacts-card">
      <% if (site.contacts_text) { %><p class="contacts-text"><%= site.contacts_text %></p><% } %>
      <ul class="contacts-list">
        <% if (site.contacts_telegram) { %>
          <li><span>Telegram:</span> <a href="<%= site.contacts_telegram %>" target="_blank" rel="noopener"><%= site.contacts_telegram %></a></li>
        <% } %>
        <% if (site.contacts_email) { %>
          <li><span>E-mail:</span> <a href="mailto:<%= site.contacts_email %>"><%= site.contacts_email %></a></li>
        <% } %>
      </ul>
    </div>

    <% if (contactsBlocks && contactsBlocks.length) { %>
      <div class="article-content contacts-content">
        <% contactsBlocks.forEach(function(block){ %>
          <% if (block.type === 'paragraph') { %>
            <p><%- block.html %></p>
          <% } else if (block.type === 'heading') { %>
            <% if (block.level === 1) { %><h1 class="c-h1"><%= block.text %></h1>
            <% } else if (block.level === 3) { %><h3 class="c-h3"><%= block.text %></h3>
            <% } else { %><h2 class="c-h2"><%= block.text %></h2><% } %>
          <% } else if (block.type === 'list') { %>
            <% if (block.style === 'ordered') { %>
              <ol class="content-list">
                <% (block.items || []).forEach(function(item){ %><li><%- item %></li><% }); %>
              </ol>
            <% } else { %>
              <ul class="content-list">
                <% (block.items || []).forEach(function(item){ %><li><%- item %></li><% }); %>
              </ul>
            <% } %>
          <% } else if (block.type === 'button') { %>
            <div class="content-btn-wrap">
              <a class="content-btn" href="<%= block.link || '#' %>" target="_blank" rel="nofollow noopener"
                 style="<%= block.bgColor ? 'background:' + block.bgColor + ';' : '' %><%= block.textColor ? 'color:' + block.textColor + ';' : '' %>"><%- block.text || 'Перейти' %></a>
            </div>
          <% } else if (block.type === 'video' && block.url) { %>
            <%- include('partials/video-embed', { url: block.url }) %>
          <% } else if (block.type === 'image' && block.url) { %>
            <figure class="content-figure">
              <img src="<%= block.url %>" alt="<%= block.captionEnabled ? block.caption : '' %>">
              <% if (block.captionEnabled && block.caption) { %>
                <figcaption><%= block.caption %></figcaption>
              <% } %>
              <% if (block.buttonEnabled && block.buttonText) { %>
                <a class="content-btn content-btn--img" href="<%= block.buttonLink || '#' %>" target="_blank" rel="nofollow noopener"><%= block.buttonText %></a>
              <% } %>
            </figure>
          <% } %>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
