<%- include('partials/header') %>

<article class="section rating-detail">
  <div class="container">
    <nav class="crumbs">
      <a href="/">Главная</a> / <a href="/rating">Рейтинг сайтов</a> /
      <a href="/rating?category=<%= item.category %>"><%= item.categoryTitle %></a> /
      <span><%= item.name %></span>
    </nav>

    <h1 class="rating-detail-title">Обзор <%= item.name %> — плюсы, минусы и отзывы</h1>

    <div class="cat-tabs">
      <% (ratingCategories || []).forEach(function(c){ %>
        <a href="/rating?category=<%= c.slug %>" class="cat-tab <%= item.category === c.slug ? 'active' : '' %>"><%= c.title %></a>
      <% }); %>
    </div>

    <!-- TOP: logo card + pros/cons -->
    <div class="rating-top">
      <div class="rating-card">
        <div class="rating-card-logo">
          <% if (item.image_url) { %>
            <img src="<%= item.image_url %>" alt="<%= item.name %>">
          <% } else { %>
            <span class="rating-logo-text"><%= item.name %></span>
          <% } %>
        </div>
        <% if (item.site_link) { %>
          <a class="rating-go" href="<%= item.site_link %>" target="_blank" rel="nofollow noopener" data-track="Рейтинг-переход: <%= item.name %>"><%= item.button_text || 'Перейти на сайт' %></a>
        <% } %>
        <div class="rating-stars rating-stars--lg">
          <span class="stars">
            <% var full = Math.round(displayRating || 0); for (var i=1;i<=5;i++){ %><span class="star <%= i<=full ? 'on':'' %>">★</span><% } %>
          </span>
          <span class="rating-num"><%= (displayRating || 0).toFixed(1) %></span>
          <% if (reviewCount) { %><span class="rating-votes">(<%= reviewCount %>)</span><% } %>
        </div>
      </div>

      <div class="proscons">
        <div class="pros-box">
          <div class="pc-title">Плюсы проекта:</div>
          <% if ((item.pros || []).length) { %>
            <ul>
              <% item.pros.forEach(function(p){ %><li><span class="pc-ic">＋</span><%= p %></li><% }); %>
            </ul>
          <% } else { %><p class="pc-empty">—</p><% } %>
        </div>
        <div class="cons-box">
          <div class="pc-title">Минусы проекта:</div>
          <% if ((item.cons || []).length) { %>
            <ul>
              <% item.cons.forEach(function(c){ %><li><span class="pc-ic">－</span><%= c %></li><% }); %>
            </ul>
          <% } else { %><p class="pc-empty">Минусов нет</p><% } %>
        </div>
      </div>
    </div>

    <% if (item.bonus_label || item.bonus_code) { %>
      <div class="rating-bonus-bar">
        <% if (item.bonus_label) { %><span class="rating-bonus-label"><%= item.bonus_label %></span><% } %>
        <% if (item.bonus_code) { %>
          <div class="promo-code rating-bonus-code" data-code="<%= item.bonus_code %>">
            <span class="promo-code-value"><%= item.bonus_code %></span>
            <button class="promo-code-copy" type="button">Копировать</button>
          </div>
        <% } %>
        <% if (item.site_link) { %><a class="rating-bonus-btn" href="<%= item.site_link %>" target="_blank" rel="nofollow noopener" data-track="Рейтинг-бонус: <%= item.name %>">Открыть</a><% } %>
      </div>
    <% } %>

    <% if (item.hero_image) { %>
      <div class="rating-banner" style="background-image:url('<%= item.hero_image %>')"></div>
    <% } %>

    <!-- ARTICLE CONTENT -->
    <% if ((item.blocks || []).length) { %>
      <div class="article-content rating-content">
        <% item.blocks.forEach(function(block){ %>
          <% if (block.type === 'paragraph') { %>
            <p><%- block.html %></p>
          <% } else if (block.type === 'heading') { %>
            <% if (block.level === 1) { %><h2 class="c-h1"><%= block.text %></h2>
            <% } else if (block.level === 3) { %><h3 class="c-h3"><%= block.text %></h3>
            <% } else { %><h2 class="c-h2"><%= block.text %></h2><% } %>
          <% } else if (block.type === 'button') { %>
            <div class="content-btn-wrap">
              <a class="content-btn" href="<%= block.link || '#' %>" target="_blank" rel="nofollow noopener"
                 style="<%= block.bgColor ? 'background:' + block.bgColor + ';' : '' %><%= block.textColor ? 'color:' + block.textColor + ';' : '' %>"><%- block.text || 'Перейти' %></a>
            </div>
          <% } else if (block.type === 'list') { %>
            <% if (block.style === 'ordered') { %>
              <ol class="content-list">
                <% (block.items || []).forEach(function(item){ %><li><%- item %></li><% }); %>
              </ol>
            <% } else { %>
              <ul class="content-list">
                <% (block.items || []).forEach(function(item){ %><li><%- item %></li><% }); %>
              </ul>
            <% } %>
          <% } else if (block.type === 'video' && block.url) { %>
            <%- include('partials/video-embed', { url: block.url }) %>
          <% } else if (block.type === 'image' && block.url) { %>
            <figure class="content-figure">
              <img src="<%= block.url %>" alt="<%= block.captionEnabled ? block.caption : '' %>">
              <% if (block.captionEnabled && block.caption) { %><figcaption><%= block.caption %></figcaption><% } %>
              <% if (block.buttonEnabled && block.buttonText) { %>
                <a class="content-btn content-btn--img" href="<%= block.buttonLink || '#' %>" target="_blank" rel="nofollow noopener"><%= block.buttonText %></a>
              <% } %>
            </figure>
          <% } %>
        <% }); %>
      </div>
    <% } %>

    <!-- REVIEWS -->
    <div class="reviews" id="reviews">
      <h2 class="section-title"><% if (site.reviews_icon_image) { %><img class="ico-img" src="<%= site.reviews_icon_image %>" alt=""><% } else { %><span class="ico"><%= site.reviews_icon || '★' %></span><% } %> Отзывы о проекте<% if (reviewCount) { %> (<%= reviewCount %>)<% } %></h2>

      <% if (justReviewed) { %>
        <div class="review-thanks">Спасибо! Ваш отзыв опубликован.</div>
      <% } %>
      <% if (typeof reviewError !== 'undefined' && reviewError) { %>
        <div class="review-error">Неверная капча. Попробуйте ещё раз.</div>
      <% } %>

      <form class="review-form" method="post" action="/rating/<%= item.slug %>/review#reviews">
        <div class="review-form-head">
          <h3 class="review-form-title">Оставить отзыв</h3>
          <div class="review-rate">
            <span class="review-rate-label">Ваша оценка:</span>
            <div class="review-stars-pick" id="reviewStars">
              <% for (var i=1;i<=5;i++){ %><button type="button" class="rs-star" data-v="<%= i %>">★</button><% } %>
              <input type="hidden" name="stars" id="reviewStarsInput" value="5">
            </div>
          </div>
        </div>
        <input type="text" name="author" class="review-input" maxlength="60" placeholder="Ваше имя">
        <textarea name="text" class="review-input" rows="3" maxlength="2000" placeholder="Поделитесь впечатлением о проекте…" required></textarea>
        <div class="captcha-row">
          <div class="captcha-box">
            <img class="captcha-img" id="captchaImg" src="/captcha.svg" alt="Капча" width="150" height="54">
            <button type="button" class="captcha-refresh" id="captchaRefresh" title="Обновить капчу" aria-label="Обновить капчу">⟳</button>
          </div>
          <input type="text" name="captcha" class="review-input captcha-input" maxlength="4" placeholder="Капча" autocomplete="off" required>
        </div>
        <button type="submit" class="btn-review-submit">Оставить отзыв</button>
      </form>

      <div class="review-list">
        <% if (!reviews.length) { %>
          <p class="empty-note">Отзывов пока нет. Оставьте первый!</p>
        <% } %>
        <% reviews.forEach(function(rv){ var rf = Math.round(rv.stars || 0); %>
          <div class="review-item">
            <div class="review-head">
              <span class="review-avatar"><%= (rv.author || 'А').trim().charAt(0).toUpperCase() %></span>
              <span class="review-author"><%= rv.author || 'Аноним' %></span>
              <span class="stars stars--sm">
                <% for (var i=1;i<=5;i++){ %><span class="star <%= i<=rf ? 'on':'' %>">★</span><% } %>
              </span>
              <span class="review-date"><%= (rv.created_at || '').slice(0,10) %></span>
            </div>
            <p class="review-text"><%= rv.text %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</article>

<script>
(function(){
  var wrap = document.getElementById('reviewStars');
  if (!wrap) return;
  var input = document.getElementById('reviewStarsInput');
  var stars = wrap.querySelectorAll('.rs-star');
  function paint(v){ stars.forEach(function(s){ s.classList.toggle('on', parseInt(s.getAttribute('data-v'),10) <= v); }); }
  stars.forEach(function(s){
    s.addEventListener('click', function(){ var v = parseInt(s.getAttribute('data-v'),10); input.value = v; paint(v); });
    s.addEventListener('mouseenter', function(){ paint(parseInt(s.getAttribute('data-v'),10)); });
  });
  wrap.addEventListener('mouseleave', function(){ paint(parseInt(input.value,10)); });
  paint(parseInt(input.value,10));
})();
(function(){
  var btn = document.getElementById('captchaRefresh');
  var img = document.getElementById('captchaImg');
  if (btn && img) btn.addEventListener('click', function(){ img.src = '/captcha.svg?ts=' + Date.now(); });
})();
</script>

<%- include('partials/footer') %>
